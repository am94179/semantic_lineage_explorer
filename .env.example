# Phase 3 will use these values to connect to the semantic index and embedding provider.
SEMANTIC_LINEAGE_QDRANT_URL=http://localhost:6333
SEMANTIC_LINEAGE_EMBEDDING_PROVIDER=openai
SEMANTIC_LINEAGE_EMBEDDING_MODEL=text-embedding-3-small
# SEMANTIC_LINEAGE_EMBEDDING_API_KEY=
SEMANTIC_LINEAGE_LLM_MODEL=gpt-5.6-terra
